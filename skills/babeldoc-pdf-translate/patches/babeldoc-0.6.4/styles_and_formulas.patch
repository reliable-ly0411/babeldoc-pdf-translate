+    @staticmethod
+    def preserve_table_math_geometry(page):
+        """Keep short mathematical runs in detected tables as original 2-D objects."""
+        tables = [t for t in page.page_layout if t.class_name == 'table']
+        if not tables:
+            return
+        fonts = {(None, f.font_id): f.name for f in page.pdf_font}
+        for obj in page.pdf_xobject:
+            fonts.update({(obj.xobj_id, f.font_id): f.name for f in obj.pdf_font})
+        nodes, owners, mixed = [], {}, []
+        def chars_of(p):
+            return [ch for c in p.pdf_paragraph_composition if c.pdf_line for ch in c.pdf_line.pdf_character]
+        def bounds(chars):
+            boxes = [(c.visual_bbox.box if c.visual_bbox else c.box) for c in chars]
+            return Box(min(b.x for b in boxes), min(b.y for b in boxes),
+                       max(b.x2 for b in boxes), max(b.y2 for b in boxes))
+        def near(a, b, size):
+            dx = max(a.x - b.x2, b.x - a.x2, 0)
+            dy = max(a.y - b.y2, b.y - a.y2, 0)
+            return dx <= size * 2.5 and dy <= size * 0.28
+        def edge_math(c):
+            text = c.char_unicode or ''
+            if text.isspace() or re.fullmatch(r'[0-9=+−×÷⇒≤≥<>()[\]{}]', text):
+                return True
+            name = fonts.get((c.xobj_id, c.pdf_style.font_id), fonts.get((None, c.pdf_style.font_id), '')) or ''
+            return len(text) == 1 and text.isalpha() and 'italic' in name.lower()
+        for p in page.pdf_paragraph:
+            if p.layout_label != 'fallback_line':
+                continue
+            chars = chars_of(p)
+            if not chars:
+                continue
+            box = bounds(chars)
+            table = next((t for t in tables if t.box.x <= box.x and box.x2 <= t.box.x2
+                          and t.box.y <= box.y and box.y2 <= t.box.y2), None)
+            if table is None:
+                continue
+            owners[id(p)] = p
+            text = p.unicode or ''.join(c.char_unicode or '' for c in chars)
+            if not re.search(r'[A-Za-z]{3,}', text) and re.search(r'[A-Za-z0-9=+−×÷⇒≤≥<>√∑∫]', text):
+                nodes.append((p, chars, box, table.id, bool(re.search(r'[=+−×÷⇒≤≥<>√∑∫]', text))))
+            else:
+                mixed.append((p, chars, table.id))
+        for p, chars, table_id in mixed:
+            for reverse in (False, True):
+                run = []
+                for c in (reversed(chars) if reverse else chars):
+                    if not edge_math(c):
+                        break
+                    run.append(c)
+                run = [c for c in run if not (c.char_unicode or '').isspace()]
+                if not run:
+                    continue
+                box = bounds(run)
+                size = max(c.pdf_style.font_size for c in run)
+                if any(n[0].xobj_id == p.xobj_id and n[3] == table_id and near(box, n[2], size) for n in nodes):
+                    nodes.append((p, run, box, table_id, False))
+        groups, used = [], set()
+        for i in range(len(nodes)):
+            if i in used:
+                continue
+            group, queue = [], [i]
+            while queue:
+                j = queue.pop()
+                if j in used:
+                    continue
+                used.add(j)
+                group.append(j)
+                a = nodes[j]
+                size = max(c.pdf_style.font_size for c in a[1])
+                queue.extend(k for k, n in enumerate(nodes) if k not in used and n[3] == a[3]
+                             and n[0].xobj_id == a[0].xobj_id and near(a[2], n[2], size))
+            if any(nodes[j][4] for j in group):
+                groups.append(group)
+        for group in groups:
+            parts = [nodes[j] for j in group]
+            anchor = next((n[0] for n in parts if len(n[1]) == len(chars_of(n[0]))), None)
+            if anchor is None:
+                continue
+            chars, seen, glyphs = [], set(), set()
+            for _, run, _, _, _ in parts:
+                for c in run:
+                    key = (c.xobj_id, c.render_order, c.pdf_character_id, c.char_unicode, c.box.x, c.box.y, c.box.x2, c.box.y2)
+                    seen.add(id(c))
+                    if key not in glyphs:
+                        chars.append(c)
+                        glyphs.add(key)
+            box = bounds(chars)
+            size = max(c.pdf_style.font_size for c in chars)
+            curves = []
+            for curve in page.pdf_curve:
+                b = curve.box
+                if b is None or curve.xobj_id != anchor.xobj_id:
+                    continue
+                if (b.x >= box.x - size and b.x2 <= box.x2 + size and b.y >= box.y - size
+                        and b.y2 <= box.y2 + size and b.x2 - b.x <= (box.x2 - box.x) * 1.2
+                        and b.y2 - b.y <= box.y2 - box.y + 2 * size):
+                    curves.append(curve)
+            formula = PdfFormula(pdf_character=chars, pdf_curve=curves, line_id=0, x_offset=0, y_offset=0)
+            update_formula_data(formula)
+            for curve in curves:
+                page.pdf_curve.remove(curve)
+            for p, _, _, _, _ in parts:
+                if p is anchor:
+                    continue
+                for comp in p.pdf_paragraph_composition:
+                    if comp.pdf_line:
+                        comp.pdf_line.pdf_character = [c for c in comp.pdf_line.pdf_character if id(c) not in seen]
+            anchor.pdf_paragraph_composition = [PdfParagraphComposition(pdf_formula=formula)]
+            anchor.box = box
+            anchor.unicode = ''.join(c.char_unicode or '' for c in chars)
+        for p in owners.values():
+            lines = [c for c in p.pdf_paragraph_composition if c.pdf_line]
+            remaining = [ch for c in lines for ch in c.pdf_line.pdf_character]
+            if lines and remaining:
+                p.box = bounds(remaining)
+                p.unicode = ''.join(c.char_unicode or '' for c in remaining)
+            if lines and not remaining:
+                p.pdf_paragraph_composition = [c for c in p.pdf_paragraph_composition if not c.pdf_line]
+        page.pdf_paragraph = [p for p in page.pdf_paragraph if p.pdf_paragraph_composition]
+
     def process_page(self, page: Page):
         """处理页面，包括公式识别和偏移量计算"""
+        self.preserve_table_math_geometry(page)
         self.process_page_formulas(page)
         # self.process_page_offsets(page)
         self.process_comma_formulas(page)
